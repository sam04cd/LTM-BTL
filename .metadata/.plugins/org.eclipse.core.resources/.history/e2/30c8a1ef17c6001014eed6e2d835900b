package sam;

/* ServerApp.java
 * Chức năng:
 * - Nhận tin nhắn client (UDP 5000)
 * - Broadcast tin nhắn (UDP 5001)
 * - Quản lý danh sách online (từ HELLO:{username})
 * - Nhận upload file (TCP 6000) và lưu vào uploads/
 * - Khi lưu file xong -> broadcast thông báo FILE:{filename}:{username}
 * - Cho phép client tải file bằng TCP GET:{filename}
 *
 * Chạy: java ServerApp
 */

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.net.*;
import java.nio.charset.StandardCharsets;
import java.util.*;
import java.util.List;
import java.util.concurrent.ConcurrentHashMap;

public class Server {

    // UDP ports
    private static final int UDP_RECV_PORT = 5000;   // server nhận client gửi
    private static final int UDP_BROADCAST_PORT = 5001; // server broadcast tới client

    // TCP port để nhận/upload và phục vụ download
    private static final int TCP_FILE_PORT = 6000;

    private DatagramSocket udpSocket;
    private JFrame frame;
    private JPanel panelMessages;
    private JTextField input;
    private JTextArea onlineArea;

    // Map clientKey -> username (clientKey = addr:port)
    private final Map<String, String> online = new ConcurrentHashMap<>();

    // Thư mục lưu file upload
    private final File uploadsDir = new File("uploads");

    public Server() {
        if (!uploadsDir.exists()) uploadsDir.mkdirs();
        createUI();
        startUdpListener();
        startTcpFileServer();
    }

    private void createUI() {
        frame = new JFrame("SERVER - Messenger UDP/TCP");
        frame.setSize(700, 700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());

        // Left: chat panel
        panelMessages = new JPanel();
        panelMessages.setLayout(new BoxLayout(panelMessages, BoxLayout.Y_AXIS));
        panelMessages.setBackground(Color.WHITE);
        JScrollPane scroll = new JScrollPane(panelMessages);
        scroll.setBorder(null);
        frame.add(scroll, BorderLayout.CENTER);

        // Right: online list + uploads
        JPanel right = new JPanel();
        right.setLayout(new BorderLayout());
        right.setPreferredSize(new Dimension(200, 0));

        JLabel lblOnline = new JLabel("Đang online");
        lblOnline.setHorizontalAlignment(SwingConstants.CENTER);
        right.add(lblOnline, BorderLayout.NORTH);

        onlineArea = new JTextArea();
        onlineArea.setEditable(false);
        right.add(new JScrollPane(onlineArea), BorderLayout.CENTER);

        frame.add(right, BorderLayout.EAST);

        // Bottom: input + emoji + send + upload file
        JPanel bottom = new JPanel(new BorderLayout(6,6));
        JPanel leftControls = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 0));

        JButton btnEmoji = new JButton("😊");
        btnEmoji.setFocusable(false);
        JPopupMenu emojiMenu = new JPopupMenu();
        String[] emojis = {"😀","😁","😂","🤣","😊","😍","😎","😡","👍","👀","❤️"};
        for (String e : emojis) {
            JMenuItem item = new JMenuItem(e);
            item.addActionListener(a -> input.setText(input.getText() + e));
            emojiMenu.add(item);
        }
        btnEmoji.addActionListener(e -> emojiMenu.show(btnEmoji, 0, btnEmoji.getHeight()));
        leftControls.add(btnEmoji);

        JButton btnUpload = new JButton("📎");
        btnUpload.setFocusable(false);
        btnUpload.addActionListener(e -> uploadFileDialog());
        leftControls.add(btnUpload);

        bottom.add(leftControls, BorderLayout.WEST);

        input = new JTextField();
        bottom.add(input, BorderLayout.CENTER);

        JButton btnSend = new JButton("Gửi (Broadcast)");
        btnSend.addActionListener(e -> {
            String text = input.getText().trim();
            if (!text.isEmpty()) {
                String msg = "Server: " + text;
                addMessageBubble("Server", text, true, null);
                broadcastUdp(msg);
                input.setText("");
            }
        });
        bottom.add(btnSend, BorderLayout.EAST);

        frame.add(bottom, BorderLayout.SOUTH);

        frame.setVisible(true);
    }

    // Thêm bubble chat (giống messenger)
    private void addMessageBubble(String name, String text, boolean mine, ImageIcon avatar) {
        JPanel row = new JPanel();
        row.setLayout(new BoxLayout(row, BoxLayout.X_AXIS));
        row.setOpaque(false);

        JPanel bubble = new RoundedPanel(mine ? new Color(0,132,255) : new Color(230,230,230));
        bubble.setLayout(new BoxLayout(bubble, BoxLayout.Y_AXIS));
        bubble.setBorder(new EmptyBorder(8,8,8,8));
        bubble.setMaximumSize(new Dimension(380, Integer.MAX_VALUE));

        JLabel lblName = new JLabel(name);
        lblName.setFont(lblName.getFont().deriveFont(Font.BOLD,12f));
        lblName.setAlignmentX(Component.LEFT_ALIGNMENT);

        JLabel lblText = new JLabel("<html>" + escapeHtml(text) + "</html>");
        lblText.setAlignmentX(Component.LEFT_ALIGNMENT);
        lblText.setFont(lblText.getFont().deriveFont(14f));
        lblText.setForeground(mine ? Color.WHITE : Color.BLACK);

        bubble.add(lblName);
        bubble.add(Box.createVerticalStrut(4));
        bubble.add(lblText);

        // avatar
        JLabel avatarLabel = new JLabel();
        avatarLabel.setPreferredSize(new Dimension(40,40));
        if (avatar != null) {
            Image img = avatar.getImage().getScaledInstance(40,40,Image.SCALE_SMOOTH);
            avatarLabel.setIcon(new ImageIcon(img));
        } else {
            // tạo avatar chữ tắt
            avatarLabel.setIcon(makeInitialsIcon(name, 40, mine ? new Color(0,102,204) : new Color(150,150,150)));
        }

        if (mine) {
            row.add(Box.createHorizontalGlue());
            row.add(bubble);
            row.add(Box.createHorizontalStrut(8));
            row.add(avatarLabel);
        } else {
            row.add(avatarLabel);
            row.add(Box.createHorizontalStrut(8));
            row.add(bubble);
            row.add(Box.createHorizontalGlue());
        }

        panelMessages.add(row);
        panelMessages.add(Box.createVerticalStrut(8));
        panelMessages.revalidate();

        // tự scroll xuống cuối
        SwingUtilities.invokeLater(() -> {
            JScrollPane sp = (JScrollPane) SwingUtilities.getAncestorOfClass(JScrollPane.class, panelMessages);
            if (sp != null) sp.getVerticalScrollBar().setValue(sp.getVerticalScrollBar().getMaximum());
        });
    }

    private ImageIcon makeInitialsIcon(String name, int size, Color bg) {
        String initials = "?";
        if (name != null && !name.isBlank()) {
            String[] parts = name.trim().split("\\s+");
            if (parts.length == 1) initials = parts[0].substring(0,1).toUpperCase();
            else {
                initials = (parts[0].substring(0,1) + parts[parts.length-1].substring(0,1)).toUpperCase();
            }
        }
        BufferedImage img = new BufferedImage(size, size, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g = img.createGraphics();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(bg);
        g.fillOval(0,0,size,size);
        g.setColor(Color.WHITE);
        g.setFont(new Font("SansSerif", Font.BOLD, size/2));
        FontMetrics fm = g.getFontMetrics();
        int w = fm.stringWidth(initials);
        int h = fm.getAscent();
        g.drawString(initials, (size-w)/2, (size+h/2)/2 + 4);
        g.dispose();
        return new ImageIcon(img);
    }

    private String escapeHtml(String s) {
        return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\n","<br/>");
    }

    // UDP: lắng nghe client gửi (5000)
    private void startUdpListener() {
        new Thread(() -> {
            try {
                udpSocket = new DatagramSocket(UDP_RECV_PORT);
                byte[] buf = new byte[8192];
                DatagramPacket p = new DatagramPacket(buf, buf.length);
                while (true) {
                    udpSocket.receive(p);
                    String msg = new String(p.getData(),0,p.getLength(), StandardCharsets.UTF_8).trim();

                    // xử lý HELLO, tin nhắn bình thường
                    if (msg.startsWith("HELLO:")) {
                        String username = msg.substring(6);
                        String key = p.getAddress().getHostAddress() + ":" + p.getPort();
                        online.put(key, username);
                        updateOnlineArea();
                        // broadcast danh sách online
                        broadcastOnlineList();
                    } else if (msg.startsWith("BYE:")) {
                        String username = msg.substring(4);
                        String key = p.getAddress().getHostAddress() + ":" + p.getPort();
                        online.remove(key);
                        updateOnlineArea();
                        broadcastOnlineList();
                    } else {
                        // tin nhắn text client gửi đến server -> hiển thị lên server và broadcast? theo yêu cầu: CHỈ server nhận tin client gửi
                        // Hiển thị trên UI server
                        addMessageBubble("Client", msg, false, null);

                        // Optionally: bạn có thể choose để server không broadcast lại tin client tới các client khác (theo yêu cầu: client gửi chỉ server nhận)
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }, "UDP-RECV").start();
    }

    // UDP: broadcast chuỗi string tới port UDP_BROADCAST_PORT
    private void broadcastUdp(String message) {
        new Thread(() -> {
            try {
                byte[] data = message.getBytes(StandardCharsets.UTF_8);
                DatagramPacket packet = new DatagramPacket(data, data.length, InetAddress.getByName("255.255.255.255"), UDP_BROADCAST_PORT);
                DatagramSocket s = new DatagramSocket();
                s.setBroadcast(true);
                s.send(packet);
                s.close();
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }).start();
    }

    // gửi danh sách online dạng: ONLINE:username1,username2,...
    private void broadcastOnlineList() {
        String list = String.join(",", online.values());
        broadcastUdp("ONLINE:" + list);
    }

    private void updateOnlineArea() {
        StringBuilder sb = new StringBuilder();
        for (String u : online.values()) sb.append(u).append("\n");
        onlineArea.setText(sb.toString());
    }

    // TCP: server file server - xử lý UPLOAD và GET
    private void startTcpFileServer() {
        new Thread(() -> {
            try (ServerSocket serverSocket = new ServerSocket(TCP_FILE_PORT)) {
                System.out.println("TCP file server on " + TCP_FILE_PORT);
                while (true) {
                    Socket client = serverSocket.accept();
                    new Thread(() -> handleFileClient(client)).start();
                }
            } catch (Exception e) {
                e.printStackTrace();
            }
        }, "TCP-FILE-SRV").start();
    }

    // Xử lý 2 dạng request:
    // - UPLOAD:{filename}:{filesize}\n  followed by raw bytes
    // - GET:{filename}\n
    private void handleFileClient(Socket client) {
        try (InputStream in = client.getInputStream();
             OutputStream out = client.getOutputStream();
             BufferedReader reader = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
             BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8))
        ) {
            String header = reader.readLine();
            if (header == null) return;
            if (header.startsWith("UPLOAD:")) {
                // UPLOAD:filename:filesize
                String[] parts = header.split(":",3);
                if (parts.length < 3) {
                    writer.write("ERR\n"); writer.flush(); return;
                }
                String filename = new File(parts[1]).getName();
                long size = Long.parseLong(parts[2]);
                File outFile = new File(uploadsDir, System.currentTimeMillis() + "_" + filename);
                try (FileOutputStream fos = new FileOutputStream(outFile)) {
                    // đọc size bytes
                    byte[] buffer = new byte[8192];
                    long remaining = size;
                    while (remaining > 0) {
                        int read = in.read(buffer,0,(int)Math.min(buffer.length, remaining));
                        if (read == -1) break;
                        fos.write(buffer,0,read);
                        remaining -= read;
                    }
                    fos.flush();
                }
                // thông báo thành công
                writer.write("OK:" + outFile.getName() + "\n");
                writer.flush();

                // broadcast tới clients: FILE:{filename}:{uploader}
                String uploader = "Unknown";
                // cố gắng lấy username từ map nếu có
                // tìm theo socket address (không hoàn hảo, nhưng sufficient)
                for (Map.Entry<String,String> e : online.entrySet()) {
                    // nếu IP match
                    if (client.getInetAddress().getHostAddress().equals(e.getKey().split(":")[0])) {
                        uploader = e.getValue();
                        break;
                    }
                }
                broadcastUdp("FILE:" + outFile.getName() + ":" + uploader);
                addMessageBubble("System", "Đã nhận file: " + outFile.getName() + " (từ " + uploader + ")", false, null);

            } else if (header.startsWith("GET:")) {
                String[] parts = header.split(":",2);
                String filename = parts[1];
                File f = new File(uploadsDir, filename);
                if (!f.exists()) {
                    writer.write("ERR\n"); writer.flush();
                } else {
                    writer.write("SIZE:" + f.length() + "\n");
                    writer.flush();
                    // gửi file bytes
                    try (FileInputStream fis = new FileInputStream(f)) {
                        byte[] buffer = new byte[8192];
                        int r;
                        while ((r = fis.read(buffer)) != -1) {
                            out.write(buffer,0,r);
                        }
                        out.flush();
                    }
                }
            } else {
                writer.write("ERR\n"); writer.flush();
            }

        } catch (Exception ex) {
            ex.printStackTrace();
        } finally {
            try { client.close(); } catch (Exception ignored){}
        }
    }

    // Dialog chọn file từ server UI để upload từ server local (không bắt buộc)
    private void uploadFileDialog() {
        JOptionPane.showMessageDialog(frame, "Server chỉ nhận upload từ clients.\nĐể demo: client dùng chức năng gửi file.");
    }

    // RoundedPanel class
    class RoundedPanel extends JPanel {
        private int radius = 16;
        public RoundedPanel(Color bg) {
            setBackground(bg); setOpaque(false);
        }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D)g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(getBackground());
            g2.fillRoundRect(0,0,getWidth(),getHeight(),radius,radius);
            super.paintComponent(g);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(Server::new);
    }
}
