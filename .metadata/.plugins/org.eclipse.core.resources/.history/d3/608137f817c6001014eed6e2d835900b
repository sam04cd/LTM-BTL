        panelMessages.setLayout(new BoxLayout(panelMessages, BoxLayout.Y_AXIS));
        panelMessages.setBackground(Color.WHITE);
        JScrollPane centerScroll = new JScrollPane(panelMessages);
        centerScroll.setBorder(null);
        frame.add(centerScroll, BorderLayout.CENTER);

        // Right panel: online + files available
        JPanel right = new JPanel();
        right.setLayout(new BorderLayout());
        right.setPreferredSize(new Dimension(220,0));
        JLabel lblOnline = new JLabel("Đang online");
        lblOnline.setHorizontalAlignment(SwingConstants.CENTER);
        right.add(lblOnline, BorderLayout.NORTH);

        onlineListModel = new DefaultListModel<>();
