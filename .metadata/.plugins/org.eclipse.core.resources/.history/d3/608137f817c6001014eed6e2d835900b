    private void addMessageBubble(String name, String text, boolean mine, ImageIcon avatar, boolean isFile, String filename) {
        JPanel row = new JPanel();
        row.setLayout(new BoxLayout(row, BoxLayout.X_AXIS));
        row.setOpaque(false);

        JPanel bubble = new RoundedPanel(mine ? new Color(0,132,255) : new Color(230,230,230));
        bubble.setLayout(new BoxLayout(bubble, BoxLayout.Y_AXIS));
        bubble.setBorder(new EmptyBorder(8,8,8,8));
        bubble.setMaximumSize(new Dimension(420, Integer.MAX_VALUE));

        JLabel lblName = new JLabel(name);
        lblName.setFont(lblName.getFont().deriveFont(Font.BOLD,12f));
        lblName.setAlignmentX(Component.LEFT_ALIGNMENT);

        JLabel lblText = new JLabel("<html>" + escapeHtml(text) + "</html>");
        lblText.setAlignmentX(Component.LEFT_ALIGNMENT);
        lblText.setFont(lblText.getFont().deriveFont(14f));
        lblText.setForeground(mine ? Color.WHITE : Color.BLACK);

        bubble.add(lblName);
        bubble.add(Box.createVerticalStrut(4));
        bubble.add(lblText);

        if (isFile && filename != null) {
            JButton btnDownload = new JButton("Tải: " + filename);
            btnDownload.addActionListener(e -> downloadFile(filename));
            bubble.add(Box.createVerticalStrut(6));
            bubble.add(btnDownload);
        }

        JLabel avatarLabel = new JLabel();
        avatarLabel.setPreferredSize(new Dimension(40,40));
        if (avatar != null) {
            Image img = avatar.getImage().getScaledInstance(40,40,Image.SCALE_SMOOTH);
            avatarLabel.setIcon(new ImageIcon(img));
        } else {
            avatarLabel.setIcon(makeInitialsIcon(name, 40, mine ? new Color(0,102,204) : new Color(150,150,150)));
        }

        if (mine) {
            row.add(Box.createHorizontalGlue());
            row.add(bubble);
            row.add(Box.createHorizontalStrut(8));
            row.add(avatarLabel);
        } else {
            row.add(avatarLabel);
            row.add(Box.createHorizontalStrut(8));
            row.add(bubble);
            row.add(Box.createHorizontalGlue());
        }

        panelMessages.add(row);
        panelMessages.add(Box.createVerticalStrut(8));
        panelMessages.revalidate();

        SwingUtilities.invokeLater(() -> {
            JScrollPane sp = (JScrollPane) SwingUtilities.getAncestorOfClass(JScrollPane.class, panelMessages);
            if (sp != null) sp.getVerticalScrollBar().setValue(sp.getVerticalScrollBar().getMaximum());
        });
    }

    private ImageIcon makeInitialsIcon(String name, int size, Color bg) {
        String initials = "?";
        if (name != null && !name.isBlank()) {
            String[] parts = name.trim().split("\\s+");
            if (parts.length == 1) initials = parts[0].substring(0,1).toUpperCase();
            else {
                initials = (parts[0].substring(0,1) + parts[parts.length-1].substring(0,1)).toUpperCase();
            }
        }
        BufferedImage img = new BufferedImage(size, size, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g = img.createGraphics();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(bg);
        g.fillOval(0,0,size,size);
        g.setColor(Color.WHITE);
        g.setFont(new Font("SansSerif", Font.BOLD, size/2));
        FontMetrics fm = g.getFontMetrics();
        int w = fm.stringWidth(initials);
        int h = fm.getAscent();
        g.drawString(initials, (size-w)/2, (size+h/2)/2 + 4);
        g.dispose();
        return new ImageIcon(img);
    }

    private String escapeHtml(String s) {
        return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\n","<br/>");
    }

    private void startUdpRecevier() {
        // start recv thread (listen broadcast from server)
        new Thread(() -> {
            try {
                udpSocketRecv = new DatagramSocket(CLIENT_UDP_PORT);
                byte[] buf = new byte[8192];
                DatagramPacket p = new DatagramPacket(buf, buf.length);
                while (true) {
                    udpSocketRecv.receive(p);
                    String msg = new String(p.getData(),0,p.getLength(), StandardCharsets.UTF_8).trim();
                    if (msg.startsWith("ONLINE:")) {
                        String list = msg.substring(7);
                        updateOnlineList(list);
                    } else if (msg.startsWith("FILE:")) {
                        // FILE:filename:username
                        String[] parts = msg.split(":",3);
                        if (parts.length >= 3) {
                            String filename = parts[1];
                            String uploader = parts[2];
                            addMessageBubble("System", "File mới: " + filename + " (từ " + uploader + ")", false, null, true, filename);
                        }
                    } else {
                        // normal broadcast from server: "Server: text"
                        addMessageBubble("Server", msg.replaceFirst("^Server:?\\s*",""), false, null, false, null);
                    }
                }
            } catch (Exception e) {
                e.printStackTrace();
            }
        }, "UDP-CLIENT-RECV").start();

        // socket to send to server
        try {
            udpSocketSend = new DatagramSocket();
        } catch (SocketException e) {
            e.printStackTrace();
        }
    }

    private void updateOnlineList(String csv) {
        SwingUtilities.invokeLater(() -> {
            onlineListModel.clear();
            if (csv != null && !csv.isBlank()) {
                String[] items = csv.split(",");
                for (String s : items) if (!s.isBlank()) onlineListModel.addElement(s);
            }
        });
    }

    private void sendHello() {
        sendUdpMessage("HELLO:" + username);
    }

    private void sendBye() {
        sendUdpMessage("BYE:" + username);
    }

    private void sendUdpMessage(String text) {
        new Thread(() -> {
            try {
                byte[] data = text.getBytes(StandardCharsets.UTF_8);
                DatagramPacket p = new DatagramPacket(data, data.length, InetAddress.getByName(SERVER_IP), SERVER_UDP_PORT);
                DatagramSocket s = new DatagramSocket();
                s.send(p);
                s.close();
            } catch (Exception e) { e.printStackTrace(); }
        }).start();
    }

    private void sendMessageToServer() {
        String txt = input.getText().trim();
        if (txt.isEmpty()) return;
        String msg = username + ": " + txt;
        addMessageBubble(username, txt, true, null, false, null); // hiển thị ở client
        sendUdpMessage(msg); // gửi tới server (chỉ server nhận)
        input.setText("");
    }

    // Chọn file rồi upload TCP tới server
    private void chooseAndUploadFile() {
        JFileChooser chooser = new JFileChooser();
        int r = chooser.showOpenDialog(frame);
        if (r == JFileChooser.APPROVE_OPTION) {
            File f = chooser.getSelectedFile();
            new Thread(() -> uploadFileToServer(f)).start();
        }
    }

    private void uploadFileToServer(File f) {
        try (Socket s = new Socket(SERVER_IP, TCP_FILE_PORT);
             OutputStream out = s.getOutputStream();
             InputStream in = s.getInputStream();
             BufferedReader br = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
             BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8))
        ) {
            String header = "UPLOAD:" + f.getName() + ":" + f.length() + "\n";
            bw.write(header);
            bw.flush();
            // send bytes
            try (FileInputStream fis = new FileInputStream(f)) {
                byte[] buffer = new byte[8192];
                int r;
                while ((r = fis.read(buffer)) != -1) {
                    out.write(buffer,0,r);
                }
                out.flush();
            }
            // read server response
            String resp = br.readLine();
            if (resp != null && resp.startsWith("OK:")) {
                String storedName = resp.substring(3);
                addMessageBubble("You", "Đã upload: " + f.getName(), true, null, false, null);
            } else {
                addMessageBubble("System", "Upload thất bại", false, null, false, null);
            }
        } catch (Exception ex) {
            ex.printStackTrace();
            addMessageBubble("System", "Lỗi upload: " + ex.getMessage(), false, null, false, null);
        }
    }

    // download file by requesting TCP GET:{filename}
    private void downloadFile(String filename) {
        new Thread(() -> {
            try (Socket s = new Socket(SERVER_IP, TCP_FILE_PORT);
                 OutputStream out = s.getOutputStream();
                 InputStream in = s.getInputStream();
                 BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8));
                 BufferedReader br = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8))
            ) {
                bw.write("GET:" + filename + "\n");
                bw.flush();
                String header = br.readLine();
                if (header == null || !header.startsWith("SIZE:")) {
                    SwingUtilities.invokeLater(() -> JOptionPane.showMessageDialog(frame, "File không tồn tại trên server"));
                    return;
                }
                long size = Long.parseLong(header.substring(5));
                File outFile = new File(downloadsDir, filename);
                try (FileOutputStream fos = new FileOutputStream(outFile)) {
                    byte[] buffer = new byte[8192];
                    long remaining = size;
                    int read;
                    while (remaining > 0 && (read = in.read(buffer,0,(int)Math.min(buffer.length, remaining))) != -1) {
                        fos.write(buffer,0,read);
                        remaining -= read;
                    }
                    fos.flush();
                }
                SwingUtilities.invokeLater(() -> {
                    addMessageBubble("System", "Đã tải: " + filename + " --> " + outFile.getAbsolutePath(), false, null, false, null);
                    // nếu file là ảnh, hiển thị ảnh
                    try {
                        Image img = ImageIO.read(outFile);
                        if (img != null) {
                            ImageIcon icon = new ImageIcon(img.getScaledInstance(200, 200, Image.SCALE_SMOOTH));
                            JLabel imgLabel = new JLabel(icon);
                            JOptionPane.showMessageDialog(frame, imgLabel, "Preview - " + filename, JOptionPane.PLAIN_MESSAGE);
                        }
                    } catch (Exception ignore) {}
                });

            } catch (Exception ex) {
                ex.printStackTrace();
                SwingUtilities.invokeLater(() -> JOptionPane.showMessageDialog(frame, "Lỗi tải file: " + ex.getMessage()));
            }
        }).start();
    }

    // RoundedPanel class
    class RoundedPanel extends JPanel {
        private int radius = 16;
        public RoundedPanel(Color bg) {
            setBackground(bg); setOpaque(false);
        }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D)g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(getBackground());
            g2.fillRoundRect(0,0,getWidth(),getHeight(),radius,radius);
            super.paintComponent(g);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            Client c = new Client();
            // add shutdown hook để gửi BYE
            Runtime.getRuntime().addShutdownHook(new Thread(() -> c.sendBye()));
        });
    }
}
