package sam;

/* ClientApp.java
 * Chức năng:
 * - Nhập tên user khi mở app
 * - Gửi HELLO:{username} tới server UDP 5000 để server biết online
 * - Lắng nghe broadcast server trên UDP 5001
 * - Gửi tin nhắn text tới server UDP 5000 (chỉ server nhận)
 * - Upload file/ảnh qua TCP tới server port 6000:
 *     - Gửi header: UPLOAD:filename:filesize\n rồi gửi raw bytes
 * - Khi server broadcast FILE:{filename}:{uploader}, client hiển thị nút TẢI về
 * - Khi click tải, client kết nối TCP GET:{filename} để download bytes và lưu vào folder downloads/
 *
 * Chạy: java ClientApp
 */

import javax.imageio.ImageIO;
import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.net.*;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.atomic.AtomicInteger;

public class Client {

    private static final String SERVER_IP = "127.0.0.1"; // đổi thành IP server khi chạy nhiều máy
    private static final int SERVER_UDP_PORT = 5000;
    private static final int CLIENT_UDP_PORT = 5001;
    private static final int TCP_FILE_PORT = 6000;

    private String username;
    private DatagramSocket udpSocketRecv;
    private DatagramSocket udpSocketSend;

    private JFrame frame;
    private JPanel panelMessages;
    private JTextField input;
    private DefaultListModel<String> onlineListModel;
    private File downloadsDir = new File("downloads");

    public Client() {
        if (!downloadsDir.exists()) downloadsDir.mkdirs();

        username = JOptionPane.showInputDialog("Nhập tên của bạn:");
        if (username == null || username.isBlank()) username = "Client";

        createUI();
        startUdpRecevier();
        sendHello();
    }

