package sam;

/* ClientApp.java
 * Client UDP/TCP + Messenger UI
 * - Sends HELLO:{username} to server UDP 5000 on startup
 * - Listens broadcast from server on UDP 5001
 * - Sends messages to server (unicast UDP 5000)
 * - Upload files to server via TCP 6000
 * - Download file via TCP 6000 with GET:{filename}
 *
 * Set SERVER_IP if server runs on other machine.
 */

import javax.imageio.ImageIO;
import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.net.*;
import java.nio.charset.StandardCharsets;
import java.awt.image.BufferedImage;
import java.util.concurrent.atomic.AtomicBoolean;

public class Client {

    private static final String SERVER_IP = "127.0.0.1"; // <- đổi khi server khác máy
    private static final int SERVER_UDP_PORT = 5000;
    private static final int CLIENT_UDP_PORT = 5001;
    private static final int TCP_FILE_PORT = 6000;

    private String username;
    private DatagramSocket recvSocket;
    private JFrame frame;
    private JPanel panelMessages;
    private JScrollPane scrollPane;
    private JTextField input;
    private JTextArea onlineArea;
    private final File downloadsDir = new File("downloads");

    public Client() {
        if (!downloadsDir.exists()) downloadsDir.mkdirs();
        username = JOptionPane.showInputDialog("Nhập tên của bạn:");
        if (username == null || username.isBlank()) username = "Client";
        createUI();
        startUdpListener();
        sendUdp("HELLO:" + username);
        Runtime.getRuntime().addShutdownHook(new Thread(() -> sendUdp("BYE:" + username)));
    }

    private void createUI() {
        frame = new JFrame("CLIENT - " + username);
        frame.setSize(900,700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());

        panelMessages = new JPanel();
        panelMessages.setLayout(new BoxLayout(panelMessages, BoxLayout.Y_AXIS));
        panelMessages.setBackground(Color.WHITE);
        scrollPane = new JScrollPane(panelMessages);
        scrollPane.setHorizontalScrollBarPolicy(ScrollPaneConstants.HORIZONTAL_SCROLLBAR_NEVER);
        frame.add(scrollPane, BorderLayout.CENTER);

        JPanel right = new JPanel(new BorderLayout());
        right.setPreferredSize(new Dimension(230,0));
        JLabel lblOnline = new JLabel("Đang online", SwingConstants.CENTER);
        right.add(lblOnline, BorderLayout.NORTH);
        onlineArea = new JTextArea();
        onlineArea.setEditable(false);
        onlineArea.setBorder(new EmptyBorder(8,8,8,8));
        right.add(new JScrollPane(onlineArea), BorderLayout.CENTER);
        frame.add(right, BorderLayout.EAST);

        JPanel bottom = new JPanel(new BorderLayout(8,8));
        JPanel leftControls = new JPanel(new FlowLayout(FlowLayout.LEFT,0,0));
        JButton btnEmoji = new JButton("😊");
        JButton btnFile  = new JButton("📎");
        leftControls.add(btnEmoji);
        leftControls.add(btnFile);
        bottom.add(leftControls, BorderLayout.WEST);

        input = new JTextField();
        bottom.add(input, BorderLayout.CENTER);

        JButton btnSend = new JButton("Gửi (chỉ server)");
        bottom.add(btnSend, BorderLayout.EAST);

        frame.add(bottom, BorderLayout.SOUTH);

        // emoji popup
        JPopupMenu emojiMenu = new JPopupMenu();
        String[] emojis = {"😀","😁","😂","🤣","😊","😍","😎","😡","👍","👀","❤️"};
        for (String e : emojis) {
            JMenuItem it = new JMenuItem(e);
            it.addActionListener(a -> input.setText(input.getText() + e));
            emojiMenu.add(it);
        }
        btnEmoji.addActionListener(a -> emojiMenu.show(btnEmoji, 0, btnEmoji.getHeight()));

        btnSend.addActionListener(a -> {
            String txt = input.getText().trim();
            if (txt.isEmpty()) return;
            addMessageBubble(username, txt, true, null);
            sendUdp(username + ": " + txt); // gửi tới server (chỉ server nhận)
            input.setText("");
        });

        btnFile.addActionListener(a -> {
            JFileChooser fc = new JFileChooser();
            int r = fc.showOpenDialog(frame);
            if (r == JFileChooser.APPROVE_OPTION) {
                File f = fc.getSelectedFile();
                new Thread(() -> uploadFile(f)).start();
            }
        });

        frame.setVisible(true);
    }

    private void addMessageBubble(String name, String message, boolean mine, ImageIcon avatar) {
        JPanel wrapper = new JPanel(new BorderLayout());
        wrapper.setOpaque(false);

        Color bg = mine ? new Color(0,132,255) : new Color(240,240,240);
        RoundedPanel bubble = new RoundedPanel(bg, 16);
        bubble.setLayout(new BoxLayout(bubble, BoxLayout.Y_AXIS));
        bubble.setBorder(new EmptyBorder(8,8,8,8));
        bubble.setMaximumSize(new Dimension(420, Integer.MAX_VALUE));
        JLabel lblName = new JLabel("<html><b>" + name + "</b></html>");
        JLabel lblMsg  = new JLabel("<html>" + escapeHtml(message) + "</html>");
        lblMsg.setForeground(mine ? Color.WHITE : Color.BLACK);
        bubble.add(lblName);
        bubble.add(Box.createVerticalStrut(6));
        bubble.add(lblMsg);

        JLabel av = new JLabel();
        av.setPreferredSize(new Dimension(40,40));
        av.setIcon(makeInitialsIcon(name, 40, mine ? new Color(0,102,204) : new Color(150,150,150)));

        if (mine) {
            wrapper.add(bubble, BorderLayout.EAST);
            wrapper.add(av, BorderLayout.WEST);
        } else {
            wrapper.add(av, BorderLayout.WEST);
            wrapper.add(bubble, BorderLayout.CENTER);
        }

        panelMessages.add(wrapper);
        panelMessages.add(Box.createVerticalStrut(8));
        revalidateAndScroll();
    }

    private void revalidateAndScroll() {
        panelMessages.revalidate();
        panelMessages.repaint();
        SwingUtilities.invokeLater(() -> scrollPane.getVerticalScrollBar().setValue(scrollPane.getVerticalScrollBar().getMaximum()));
    }

    private String escapeHtml(String s){
        return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\n","<br/>");
    }

    private ImageIcon makeInitialsIcon(String name, int size, Color bg) {
        String initials = "?";
        if (name != null && !name.isBlank()) {
            String[] p = name.trim().split("\\s+");
            if (p.length == 1) initials = p[0].substring(0,1).toUpperCase();
            else initials = (p[0].substring(0,1) + p[p.length-1].substring(0,1)).toUpperCase();
        }
        BufferedImage img = new BufferedImage(size,size,BufferedImage.TYPE_INT_ARGB);
        Graphics2D g = img.createGraphics();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(bg);
        g.fillOval(0,0,size,size);
        g.setColor(Color.WHITE);
        g.setFont(new Font("SansSerif", Font.BOLD, size/2));
        FontMetrics fm = g.getFontMetrics();
        int w = fm.stringWidth(initials);
        int h = fm.getAscent();
        g.drawString(initials, (size-w)/2, (size+h/2)/2 + 4);
        g.dispose();
        return new ImageIcon(img);
    }

    /* ================= UDP listen broadcast from server ================= */
    private void startUdpListener() {
        new Thread(() -> {
            try {
                recvSocket = new DatagramSocket(CLIENT_UDP_PORT);
                byte[] buf = new byte[8192];
                DatagramPacket p = new DatagramPacket(buf, buf.length);
                while (true) {
                    recvSocket.receive(p);
                    String msg = new String(p.getData(), 0, p.getLength(), StandardCharsets.UTF_8).trim();
                    if (msg.startsWith("ONLINE:")) {
                        String list = msg.substring(7);
                        SwingUtilities.invokeLater(() -> onlineArea.setText(list.replace(",", "\n")));
                    } else if (msg.startsWith("FILE:")) {
                        String[] parts = msg.split(":",3);
                        if (parts.length >= 3) {
                            String fname = parts[1];
                            String uploader = parts[2];
                            addMessageBubble("System", "File mới: " + fname + " (từ " + uploader + ")", false, null);
                            // add a download button? for brevity, message displayed
                        }
                    } else {
                        // normal broadcast message from server e.g. "Server: hello"
                        addMessageBubble("Server", msg.replaceFirst("^Server:?\\s*",""), false, null);
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }, "UDP-CLIENT-RECV").start();
    }

    private void sendUdp(String text) {
        new Thread(() -> {
            try {
                byte[] data = text.getBytes(StandardCharsets.UTF_8);
                DatagramPacket p = new DatagramPacket(data, data.length, InetAddress.getByName(SERVER_IP), SERVER_UDP_PORT);
                DatagramSocket s = new DatagramSocket();
                s.send(p);
                s.close();
            } catch (Exception e) { e.printStackTrace(); }
        }).start();
    }

    /* ================= TCP upload/download ================= */
    private void uploadFile(File f) {
        SwingUtilities.invokeLater(() -> addMessageBubble("You", "Đang upload: " + f.getName(), true, null));
        try (Socket s = new Socket(SERVER_IP, TCP_FILE_PORT);
             OutputStream out = s.getOutputStream();
             InputStream in = s.getInputStream();
             BufferedReader br = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
             BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8))
        ) {
            bw.write("UPLOAD:" + f.getName() + ":" + f.length() + "\n");
            bw.flush();
            try (FileInputStream fis = new FileInputStream(f)) {
                byte[] buffer = new byte[8192];
                int r;
                while ((r = fis.read(buffer)) != -1) out.write(buffer,0,r);
                out.flush();
            }
            String resp = br.readLine();
            if (resp != null && resp.startsWith("OK:")) {
                addMessageBubble("System", "Upload thành công: " + resp.substring(3), false, null);
            } else addMessageBubble("System", "Upload thất bại", false, null);
        } catch (Exception e) {
            e.printStackTrace();
            addMessageBubble("System", "Lỗi upload: " + e.getMessage(), false, null);
        }
    }

    private void downloadFile(String filename) {
        new Thread(() -> {
            try (Socket s = new Socket(SERVER_IP, TCP_FILE_PORT);
                 OutputStream out = s.getOutputStream();
                 InputStream in = s.getInputStream();
                 BufferedReader br = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
                 BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8))
            ) {
                bw.write("GET:" + filename + "\n");
                bw.flush();
                String header = br.readLine();
                if (header == null || !header.startsWith("SIZE:")) {
                    addMessageBubble("System", "File không tồn tại", false, null);
                    return;
                }
                long size = Long.parseLong(header.substring(5));
                File outF = new File(downloadsDir, filename);
                try (FileOutputStream fos = new FileOutputStream(outF)) {
                    byte[] buffer = new byte[8192];
                    long rem = size;
                    int r;
                    while (rem > 0 && (r = in.read(buffer,0,(int)Math.min(buffer.length, rem))) != -1) {
                        fos.write(buffer,0,r);
                        rem -= r;
                    }
                    fos.flush();
                }
                addMessageBubble("System", "Tải xong: " + outF.getAbsolutePath(), false, null);
            } catch (Exception ex) {
                ex.printStackTrace();
                addMessageBubble("System", "Lỗi tải: " + ex.getMessage(), false, null);
            }
        }).start();
    }

    class RoundedPanel extends JPanel {
        private int radius;
        public RoundedPanel(Color bg, int radius) {
            this.radius = radius; setBackground(bg); setOpaque(false);
        }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(getBackground());
            g2.fillRoundRect(0,0,getWidth(),getHeight(),radius,radius);
            super.paintComponent(g);
        }
    }

    /* ================= main ================= */
    public static void main(String[] args) {
        SwingUtilities.invokeLater(Client::new);
    }
}
