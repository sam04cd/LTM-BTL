package sam;

/* ServerApp.java
 * Server UDP/TCP + UI Messenger
 * - UDP: receive client -> port 5000 (unicast)
 * - UDP: broadcast server -> clients port 5001 (broadcast)
 * - TCP: file upload/download -> port 6000
 *
 * UI không dùng FlatLaf để tránh lỗi ClassNotFoundException.
 */

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.net.*;
import java.nio.charset.StandardCharsets;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.awt.image.BufferedImage;

public class Server {

    private static final int UDP_RECV_PORT = 5000;
    private static final int UDP_BROADCAST_PORT = 5001;
    private static final int TCP_FILE_PORT = 6000;
    private static final String BROADCAST_IP = "255.255.255.255";

    private JFrame frame;
    private JPanel panelMessages;
    private JScrollPane scrollPane;
    private JTextField input;
    private JTextArea onlineArea;

    private DatagramSocket udpRecvSocket;
    private final Map<String, String> online = new ConcurrentHashMap<>();
    private final File uploadsDir = new File("uploads");

    public Server() {

        /* Không dùng FlatLaf để tránh lỗi ở dòng 22 và 48 */
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception ignored) {}

        if (!uploadsDir.exists()) uploadsDir.mkdirs();

        createUI();
        startUdpReceiver();
        startTcpFileServer();
    }

    private void createUI() {
        frame = new JFrame("SERVER - Messenger UDP/TCP");
        frame.setSize(900, 700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLayout(new BorderLayout());

        panelMessages = new JPanel();
        panelMessages.setLayout(new BoxLayout(panelMessages, BoxLayout.Y_AXIS));
        panelMessages.setBackground(Color.WHITE);
        scrollPane = new JScrollPane(panelMessages);

        scrollPane.setBorder(BorderFactory.createEmptyBorder());
        scrollPane.setHorizontalScrollBarPolicy(ScrollPaneConstants.HORIZONTAL_SCROLLBAR_NEVER);
        frame.add(scrollPane, BorderLayout.CENTER);

        JPanel right = new JPanel(new BorderLayout());
        right.setPreferredSize(new Dimension(230, 0));
        right.setBorder(BorderFactory.createMatteBorder(0, 1, 0, 0, new Color(220, 220, 220)));

        JLabel lblOnline = new JLabel("Đang online", SwingConstants.CENTER);
        lblOnline.setFont(lblOnline.getFont().deriveFont(Font.BOLD, 14f));
        lblOnline.setBorder(BorderFactory.createEmptyBorder(10, 0, 10, 0));
        right.add(lblOnline, BorderLayout.NORTH);

        onlineArea = new JTextArea();
        onlineArea.setEditable(false);
        onlineArea.setBorder(new EmptyBorder(8,8,8,8));
        right.add(new JScrollPane(onlineArea), BorderLayout.CENTER);
        frame.add(right, BorderLayout.EAST);

        JPanel bottom = new JPanel(new BorderLayout(8,8));
        bottom.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        JPanel leftControls = new JPanel(new FlowLayout(FlowLayout.LEFT,5,0));
        leftControls.setOpaque(false);
        JButton btnEmoji = new JButton("😊");
        JButton btnUpload = new JButton("📎");

        leftControls.add(btnEmoji);
        leftControls.add(btnUpload);
        bottom.add(leftControls, BorderLayout.WEST);

        input = new JTextField();
        bottom.add(input, BorderLayout.CENTER);

        JButton btnSend = new JButton("Gửi (Broadcast)");
        btnSend.setBackground(new Color(0, 132, 255));
        btnSend.setForeground(Color.WHITE);
        bottom.add(btnSend, BorderLayout.EAST);

        frame.add(bottom, BorderLayout.SOUTH);

        JPopupMenu emojiMenu = new JPopupMenu();
        String[] emojis = {"😀","😁","😂","🤣","😊","😍","😎","😡","👍","👀","❤️"};
        for (String e : emojis) {
            JMenuItem it = new JMenuItem(e);
            it.addActionListener(a -> input.setText(input.getText() + e));
            emojiMenu.add(it);
        }
        btnEmoji.addActionListener(a -> emojiMenu.show(btnEmoji, 0, btnEmoji.getHeight()));

        btnUpload.addActionListener(a ->
                JOptionPane.showMessageDialog(frame, "Server không upload file ở UI. Dùng client để upload.")
        );

        btnSend.addActionListener(a -> {
            String text = input.getText().trim();
            if (text.isEmpty()) return;
            String msg = "Server: " + text;
            addMessageBubble("Server", text, true, null);
            broadcastUdp(msg);
            input.setText("");
        });

        frame.setVisible(true);
    }

    private void addMessageBubble(String name, String message, boolean mine, ImageIcon avatar) {
        JPanel wrapper = new JPanel(new BorderLayout());
        wrapper.setOpaque(false);

        Color bg = mine ? new Color(0,132,255) : new Color(240,240,240);
        RoundedPanel bubble = new RoundedPanel(bg, 16);
        bubble.setLayout(new BoxLayout(bubble, BoxLayout.Y_AXIS));
        bubble.setBorder(new EmptyBorder(8,8,8,8));
        bubble.setMaximumSize(new Dimension(380, Integer.MAX_VALUE));

        JLabel lblName = new JLabel("<html><b>" + name + "</b></html>");
        lblName.setAlignmentX(Component.LEFT_ALIGNMENT);
        JLabel lblMsg  = new JLabel("<html>" + escapeHtml(message) + "</html>");
        lblMsg.setAlignmentX(Component.LEFT_ALIGNMENT);
        lblMsg.setForeground(mine ? Color.WHITE : Color.BLACK);

        bubble.add(lblName);
        bubble.add(Box.createVerticalStrut(6));
        bubble.add(lblMsg);

        JLabel av = new JLabel();
        av.setPreferredSize(new Dimension(40,40));
        av.setIcon(makeInitialsIcon(name, 40, mine ? new Color(0,102,204) : new Color(150,150,150)));

        if (mine) {
            wrapper.add(bubble, BorderLayout.EAST);
            wrapper.add(av, BorderLayout.WEST);
        } else {
            wrapper.add(av, BorderLayout.WEST);
            wrapper.add(bubble, BorderLayout.CENTER);
        }

        panelMessages.add(wrapper);
        panelMessages.add(Box.createVerticalStrut(8));
        revalidateAndScroll();
    }

    private void revalidateAndScroll() {
        panelMessages.revalidate();
        panelMessages.repaint();
        SwingUtilities.invokeLater(() ->
                scrollPane.getVerticalScrollBar().setValue(scrollPane.getVerticalScrollBar().getMaximum())
        );
    }

    private String escapeHtml(String s){
        return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\n","<br/>");
    }

    private ImageIcon makeInitialsIcon(String name, int size, Color bg) {
        String initials = "?";
        if (name != null && !name.isBlank()) {
            String[] p = name.trim().split("\\s+");
            if (p.length == 1) initials = p[0].substring(0,1).toUpperCase();
            else initials = (p[0].substring(0,1) + p[p.length-1].substring(0,1)).toUpperCase();
        }
        BufferedImage img = new BufferedImage(size,size,BufferedImage.TYPE_INT_ARGB);
        Graphics2D g = img.createGraphics();
        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g.setColor(bg);
        g.fillOval(0,0,size,size);
        g.setColor(Color.WHITE);
        g.setFont(new Font("SansSerif", Font.BOLD, size/2));
        FontMetrics fm = g.getFontMetrics();
        int w = fm.stringWidth(initials);
        int h = fm.getAscent();
        g.drawString(initials, (size-w)/2, (size+h/2)/2 + 4);
        g.dispose();
        return new ImageIcon(img);
    }

    private void startUdpReceiver() {
        new Thread(() -> {
            try {
                udpRecvSocket = new DatagramSocket(UDP_RECV_PORT);
                byte[] buf = new byte[8192];
                DatagramPacket p = new DatagramPacket(buf, buf.length);
                while (true) {
                    udpRecvSocket.receive(p);
                    String msg = new String(p.getData(), 0, p.getLength(), StandardCharsets.UTF_8).trim();
                    String key = p.getAddress().getHostAddress() + ":" + p.getPort();

                    if (msg.startsWith("HELLO:")) {
                        String name = msg.substring(6);
                        online.put(key, name);
                        updateOnlineArea();
                        broadcastOnlineList();
                    } else if (msg.startsWith("BYE:")) {
                        online.remove(key);
                        updateOnlineArea();
                        broadcastOnlineList();
                    } else {
                        addMessageBubble(online.getOrDefault(key,"Client"), msg, false, null);
                    }
                }
            } catch (Exception ex) {
                ex.printStackTrace();
            }
        }, "UDP-RECV").start();
    }

    private void updateOnlineArea() {
        SwingUtilities.invokeLater(() -> {
            StringBuilder sb = new StringBuilder();
            for (String v : online.values()) sb.append(v).append("\n");
            onlineArea.setText(sb.toString());
        });
    }

    private void broadcastOnlineList() {
        String list = String.join(",", online.values());
        broadcastUdp("ONLINE:" + list);
    }

    private void broadcastUdp(String message) {
        new Thread(() -> {
            DatagramSocket s = null;
            try {
                byte[] data = message.getBytes(StandardCharsets.UTF_8);
                InetAddress addr = InetAddress.getByName(BROADCAST_IP);
                DatagramPacket packet = new DatagramPacket(data, data.length, addr, UDP_BROADCAST_PORT);
                s = new DatagramSocket();
                s.setBroadcast(true);
                s.send(packet);
            } catch (Exception e) {
                e.printStackTrace();
            } finally {
                if (s != null) s.close();
            }
        }).start();
    }

    private void startTcpFileServer() {
        new Thread(() -> {
            try (ServerSocket server = new ServerSocket(TCP_FILE_PORT)) {
                System.out.println("TCP file server on " + TCP_FILE_PORT);
                while (true) {
                    Socket client = server.accept();
                    new Thread(() -> handleFileClient(client)).start();
                }
            } catch (Exception e) {
                e.printStackTrace();
            }
        }, "TCP-FILE-SRV").start();
    }

    private void handleFileClient(Socket client) {
        try (InputStream in = client.getInputStream();
             OutputStream out = client.getOutputStream();
             BufferedReader br = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
             BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(out, StandardCharsets.UTF_8))
        ) {
            String header = br.readLine();
            if (header == null) return;

            if (header.startsWith("UPLOAD:")) {
                String[] parts = header.split(":",3);
                String fname = new File(parts[1]).getName();
                long size = Long.parseLong(parts[2]);
                File saved = new File(uploadsDir, System.currentTimeMillis() + "_" + fname);

                try (FileOutputStream fos = new FileOutputStream(saved)) {
                    byte[] buffer = new byte[8192];
                    long rem = size;
                    while (rem > 0) {
                        int r = in.read(buffer,0,(int)Math.min(buffer.length, rem));
                        if (r == -1) break;
                        fos.write(buffer,0,r);
                        rem -= r;
                    }
                    fos.flush();
                }

                bw.write("OK:" + saved.getName() + "\n");
                bw.flush();

                broadcastUdp("FILE:" + saved.getName() + ":" + "unknown");
                addMessageBubble("System","Đã nhận file: " + saved.getName(), false, null);

            } else if (header.startsWith("GET:")) {
                String[] parts = header.split(":",2);
                File f = new File(uploadsDir, parts[1]);

                if (!f.exists()) {
                    bw.write("ERR\n"); bw.flush();
                } else {
                    bw.write("SIZE:" + f.length() + "\n"); bw.flush();
                    try (FileInputStream fis = new FileInputStream(f)) {
                        byte[] buffer = new byte[8192];
                        int r;
                        while ((r = fis.read(buffer)) != -1) out.write(buffer,0,r);
                        out.flush();
                    }
                }

            } else {
                bw.write("ERR\n"); bw.flush();
            }

        } catch (Exception ex) {
            ex.printStackTrace();
        } finally {
            try { client.close(); } catch (Exception ignored) {}
        }
    }

    class RoundedPanel extends JPanel {
        private int radius;
        public RoundedPanel(Color bg, int radius) {
            this.radius = radius;
            setBackground(bg);
            setOpaque(false);
        }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(getBackground());
            g2.fillRoundRect(0,0,getWidth(),getHeight(), radius, radius);
            super.paintComponent(g);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new Server());
    }
}
